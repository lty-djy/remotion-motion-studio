{
  "name": "motion-component-studio-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:icons": "node ai-motion-arranger/scripts/generate-built-in-icons.mjs",
    "generate:candidate-thumbs": "node outputs/generate-candidate-thumbs.cjs",
    "sync:registry": "node ai-motion-arranger/scripts/sync-runtime-registry.mjs && node ai-motion-arranger/scripts/generate-card-catalog.mjs",
    "sync:arranger-catalog": "node overlay-fx-generator/scripts/generate-component-catalog.mjs",
    "lint:arrangement": "node overlay-fx-generator/scripts/lint-arrangement-json.mjs",
    "sync:resources": "node ai-motion-arranger/scripts/build-resource-index.mjs",
    "validate:resources": "node ai-motion-arranger/scripts/validate-resource-index.mjs",
    "prevalidate:visual-script": "npm run sync:registry && npm run sync:resources",
    "validate:visual-script": "node ai-motion-arranger/scripts/validate-visual-script.mjs",
    "pretest:visual-script": "npm run sync:registry && npm run sync:resources",
    "test:visual-script": "node ai-motion-arranger/scripts/test-visual-script.mjs",
    "pretest:timeline-v2": "npm run sync:registry && npm run sync:resources",
    "test:timeline-v2": "node ai-motion-arranger/scripts/test-timeline-v2.mjs",
    "test:semantic-arranger": "node ai-motion-arranger/scripts/test-semantic-srt-arranger.mjs",
    "test:semantic-capabilities": "node ai-motion-arranger/scripts/test-semantic-capabilities.mjs",
    "calibrate:srt": "node ai-motion-arranger/scripts/calibrate-srt-semantics.mjs",
    "test:avoidance-layout": "node ai-motion-arranger/scripts/test-avoidance-layout.mjs",
    "test:quality-control": "node ai-motion-arranger/scripts/test-quality-control.mjs",
    "test:arrangement-batch": "node ai-motion-arranger/scripts/test-arrangement-batch.mjs",
    "test:portrait-effects": "node ai-motion-arranger/scripts/test-portrait-reference-effects.mjs",
    "test:risk-warning-effects": "node ai-motion-arranger/scripts/test-risk-warning-effects.mjs",
    "test:portrait-routes": "node ai-motion-arranger/scripts/test-portrait-semantic-routes.mjs",
    "test:srt-merge": "node ai-motion-arranger/scripts/test-srt-semantic-merger.mjs",
    "convert:visual-script": "node ai-motion-arranger/scripts/visual-script-to-timeline.mjs",
    "predev": "npm run sync:registry && npm run sync:resources",
    "dev": "vite --config local-vite.config.ts",
    "prebuild": "npm run sync:registry && npm run sync:resources",
    "build": "vite build --config local-vite.config.ts",
    "prestart": "npm run sync:registry && npm run sync:resources",
    "start": "vite --config local-vite.config.ts --host 127.0.0.1 --port 41735"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/bundler": "4.0.499",
    "@remotion/player": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "@vitejs/plugin-react": "latest",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.499",
    "vite": "latest"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
